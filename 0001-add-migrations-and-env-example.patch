diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..11989cd
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,40 @@
+# Copy this file to .env.local and fill in the values. Restart `npm run dev` after any change.
+# See SETUP.md for the full walkthrough.
+
+## 1. Supabase (required)
+# Settings > API Keys in your Supabase project.
+NEXT_PUBLIC_SUPABASE_URL=
+NEXT_PUBLIC_SUPABASE_ANON_KEY=
+# Secret key. Server only — bypasses row level security. Never expose this to the browser.
+SUPABASE_SERVICE_ROLE_KEY=
+
+## 2. AI provider (optional — leave all three blank for mock mode, no network calls)
+# Any OpenAI-compatible API (Google AI Studio's free tier, Groq, OpenRouter, ...).
+AI_API_KEY=
+# Defaults to Google AI Studio's OpenAI-compatible endpoint if AI_API_KEY is set and this is blank.
+AI_BASE_URL=
+# Model id to use when the ones below are not set.
+AI_MODEL=
+# Optional per-purpose overrides. AI_MODEL_AGENT falls back to AI_MODEL_DRAFT, then AI_MODEL.
+AI_MODEL_EXTRACT=
+AI_MODEL_DRAFT=
+AI_MODEL_AGENT=
+# Alternative to AI_API_KEY: use Claude directly instead of an OpenAI-compatible endpoint.
+ANTHROPIC_API_KEY=
+
+## 3. WhatsApp Cloud API (optional while testing with scripts/simulate-webhook.mjs)
+# The token Meta sends back on GET requests to verify your webhook URL. Any string you choose.
+WHATSAPP_VERIFY_TOKEN=
+# App secret, used to verify the x-hub-signature-256 header on every webhook POST.
+WHATSAPP_APP_SECRET=
+# Set to "live" (and set WHATSAPP_ACCESS_TOKEN) to actually send messages via the Cloud API.
+# Any other value (or unset) stays in dry mode: replies are saved in the chat, not delivered.
+WHATSAPP_SEND_MODE=
+WHATSAPP_ACCESS_TOKEN=
+# Defaults to v23.0 if unset.
+WHATSAPP_API_VERSION=
+
+## 4. Cron (required once deployed, for app/api/cron/follow-ups)
+# Vercel Cron sends this as "Authorization: Bearer <value>". Set the same value in
+# the project's environment variables on Vercel. Any long random string.
+CRON_SECRET=
