From 8503d42511acf0ab17133748f5e5bf124b4cd580 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 06:54:11 +0000
Subject: [PATCH] Stack button rows on mobile

Buttons are now full width below md, so rows that put a button beside another button or a message overflowed. They now stack on phones and sit in a row from sm up. Scrolling filter chips keep their natural width.
---
 components/SettingsForm.tsx               | 4 ++--
 components/follow-ups/follow-up-forms.tsx | 4 ++--
 components/follow-ups/follow-ups-view.tsx | 2 +-
 components/inbox/chat-filter-sheet.tsx    | 2 +-
 components/knowledge/entry-form-sheet.tsx | 2 +-
 components/knowledge/knowledge-view.tsx   | 2 +-
 6 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/components/SettingsForm.tsx b/components/SettingsForm.tsx
index 6b3810c..9c10ed3 100644
--- a/components/SettingsForm.tsx
+++ b/components/SettingsForm.tsx
@@ -220,9 +220,9 @@ export function SettingsForm({
         </CardContent>
       </Card>
 
-      <div className="sticky bottom-4 z-10 flex items-center justify-end gap-3 rounded-xl border bg-card/95 p-3 shadow-md backdrop-blur">
+      <div className="sticky bottom-4 z-10 flex flex-col gap-2 rounded-xl border bg-card/95 p-3 shadow-md backdrop-blur sm:flex-row sm:items-center sm:justify-end sm:gap-3">
         {dirty && (
-          <p role="status" className="text-sm font-medium text-muted-foreground">
+          <p role="status" className="text-center text-sm font-medium text-muted-foreground sm:text-right">
             You have unsaved changes
           </p>
         )}
diff --git a/components/follow-ups/follow-up-forms.tsx b/components/follow-ups/follow-up-forms.tsx
index aae51a4..4eb9253 100644
--- a/components/follow-ups/follow-up-forms.tsx
+++ b/components/follow-ups/follow-up-forms.tsx
@@ -253,9 +253,9 @@ export function AutomationsForm({
         </CardContent>
       </Card>
 
-      <div className="sticky bottom-4 z-10 flex items-center justify-end gap-3 rounded-xl border bg-card/95 p-3 shadow-md backdrop-blur">
+      <div className="sticky bottom-4 z-10 flex flex-col gap-2 rounded-xl border bg-card/95 p-3 shadow-md backdrop-blur sm:flex-row sm:items-center sm:justify-end sm:gap-3">
         {dirty && (
-          <p role="status" className="text-sm font-medium text-muted-foreground">
+          <p role="status" className="text-center text-sm font-medium text-muted-foreground sm:text-right">
             You have unsaved changes
           </p>
         )}
diff --git a/components/follow-ups/follow-ups-view.tsx b/components/follow-ups/follow-ups-view.tsx
index ed1d43d..3e1e3cc 100644
--- a/components/follow-ups/follow-ups-view.tsx
+++ b/components/follow-ups/follow-ups-view.tsx
@@ -332,7 +332,7 @@ export function FollowUpsView({
                 variant={filter === f.id ? "default" : "outline"}
                 aria-pressed={filter === f.id}
                 onClick={() => setFilter(f.id)}
-                className="shrink-0"
+                className="shrink-0 max-md:w-auto"
               >
                 {f.label} {f.count}
               </Button>
diff --git a/components/inbox/chat-filter-sheet.tsx b/components/inbox/chat-filter-sheet.tsx
index 483d6a4..07b2546 100644
--- a/components/inbox/chat-filter-sheet.tsx
+++ b/components/inbox/chat-filter-sheet.tsx
@@ -92,7 +92,7 @@ export function ChatFilterSheet({
           </div>
         </div>
 
-        <div className="mt-auto flex items-center justify-between gap-3 border-t p-4">
+        <div className="mt-auto flex flex-col-reverse gap-2 border-t p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
           <Button
             variant="ghost"
             size="sm"
diff --git a/components/knowledge/entry-form-sheet.tsx b/components/knowledge/entry-form-sheet.tsx
index b6b5e61..658bd43 100644
--- a/components/knowledge/entry-form-sheet.tsx
+++ b/components/knowledge/entry-form-sheet.tsx
@@ -96,7 +96,7 @@ export function EntryFormSheet({
             </div>
           </div>
 
-          <div className="mt-auto flex items-center justify-end gap-3 border-t p-4">
+          <div className="mt-auto flex flex-col-reverse gap-2 border-t p-4 sm:flex-row sm:items-center sm:justify-end sm:gap-3">
             <SheetClose asChild>
               <Button type="button" variant="ghost">
                 Cancel
diff --git a/components/knowledge/knowledge-view.tsx b/components/knowledge/knowledge-view.tsx
index f1823ea..84ae877 100644
--- a/components/knowledge/knowledge-view.tsx
+++ b/components/knowledge/knowledge-view.tsx
@@ -54,7 +54,7 @@ function Section({
         <p className="max-w-md text-muted-foreground">
           {KB_CATEGORY_HINT[category]}
         </p>
-        <div className="flex items-center gap-2">
+        <div className="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
           <FactsPreview />
           <EntryFormSheet
             category={category}
